{
  "name": "esigglol",
  "version": "1.2.1",
  "private": true,
  "scripts": {
    "audit:cloudflare": "node scripts/audit-cloudflare.mjs",
    "test:audit-cloudflare": "node --test scripts/__tests__/audit-cloudflare.test.mjs",
    "sync-valorant": "tsx scripts/sync-valorant.ts",
    "sync-ddragon": "tsx scripts/sync-ddragon.ts",
    "generate-session-secret": "tsx scripts/generate-session-secret.ts",
    "dev:valorant-sandbox": "tsx scripts/start-valorant-sandbox.ts",
    "test-valorant": "tsx scripts/test-valorant-api.ts",
    "test-riot": "tsx scripts/test-riot-api.ts",
    "collect-stats-dev": "tsx scripts/collect-stats-dev.ts",
    "collect-stats-prod": "tsx scripts/collect-stats-prod.ts",
    "backup": "tsx scripts/backup-sqlite.ts",
    "backup:verify": "tsx scripts/backup-sqlite.ts --verify",
    "backup:restore": "tsx scripts/restore-sqlite.ts",
    "predev": "tsx scripts/sync-ddragon.ts && tsx scripts/sync-valorant.ts --optional",
    "prebuild": "tsx scripts/sync-ddragon.ts && tsx scripts/sync-valorant.ts --optional",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "prepare": "husky",
    "prebuild:cloudflare": "node cloudflare/sync-assets.mjs && node cloudflare/prepare-public.mjs",
    "build:cloudflare": "npm run types:cloudflare && vite build --config cloudflare/vite.config.mjs",
    "types:cloudflare": "mkdir -p cloudflare/generated && wrangler types --config cloudflare/wrangler.jsonc cloudflare/generated/env.d.ts",
    "check:cloudflare": "tsc --noEmit -p cloudflare/tsconfig.json",
    "test:cloudflare": "node cloudflare/storage.test.mjs && node cloudflare/smoke.mjs",
    "deploy:cloudflare": "wrangler deploy --config dist/server/wrangler.json"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --max-warnings=0 --fix"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.2",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "react": "^19.2.6",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.6",
    "yauzl": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "miniflare": "5.20261006.1-alpha",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vinext": "^1.1.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  }
}
