# Copy to .env.local and replace every required value with a secret kept
# outside the repository (for example, a deployment secret manager).
ADMIN_PASSWORD_HASH=''
SESSION_SECRET=

# Optional integrations. Never commit real API keys.
RIOT_API_KEY=
RIOT_REGION=euw1
TOURNAMENT_API_MODE=stub
TWITCH_CHANNEL=
ANTHROPIC_API_KEY=

# Optional runtime configuration.
DB_PATH=./data/esigglol.db
REFRESH_AUTO_INTERVAL_MS=21600000
REFRESH_BATCH_SIZE=3
REFRESH_BATCH_DELAY_MS=30000
