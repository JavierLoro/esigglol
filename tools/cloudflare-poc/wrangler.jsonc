{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "esigglol-feasibility-local",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "dist/client", "binding": "ASSETS", "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "esigglol-feasibility-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "esigglol-feasibility-local" }]
}
