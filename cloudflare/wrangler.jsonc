{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "esigglol-application",
  "main": "worker.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "esiggesports.jlc-dev.me", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "APPLICATION", "class_name": "EsiggApplication" }, { "name": "FILE_BUDGET", "class_name": "FileBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EsiggApplication", "FileBudget"] }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "esigglol-application" }],
  "assets": { "directory": "../dist/client", "binding": "ASSETS" },
  "vars": { "INSTALLATION_ID": "esiggesports", "IS_CLOUDFLARE": "1", "REFRESH_AUTO_INTERVAL_MS": "21600000" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "redact_query_string": true }
}
